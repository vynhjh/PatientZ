extends Node3D
## Realistic blood made with Godot 4 Decal nodes (Forward+ / Mobile renderers).
##
## How it works:
##   A Decal projects textures along its local -Y axis onto every mesh inside its box.
##   - Floor stains: the Decal points down (default rotation).
##   - Wall stains: the Decal is rotated so its -Y points into the wall.
##   Each Decal uses 3 textures generated by code (no image files needed):
##     albedo  → colour: dark crimson centre, brownish edges, irregular noisy outline
##     normal  → relief, so thick blood catches the light
##     ORM     → roughness: wet blood is shiny, dried blood is matte
##   Decals only affect visual layer 1 (the lab), so players and infected (layer 2)
##   are never stained.
##
## Kinds of stain: SPLATTER, POOL, DRIP (walls, runs downwards), SMEAR (drag marks), DRIED.
##
## Usage from the floor script:
##   It is the "Blood" node of the floor scene.
##   blood.spawn_in_room(cells, amount, cell_to_world, wall_dir, cell_size)
##   blood.splatter_floor(position, size) · blood.pool(position) · blood.hit_splash(position)

enum Kind { SPLATTER, POOL, DRIP, SMEAR, DRIED }

const TEXTURE_SIZE := 192
const VARIANTS := 3              # textures per kind
const MAX_DYNAMIC := 80          # hits and pools; the oldest ones are removed

static var _sets := {}           # Kind -> Array of {albedo, normal, orm}

var _rng := RandomNumberGenerator.new()
var _dynamic: Array[Decal] = []


func _ready() -> void:
	_rng.seed = 666
	if _sets.is_empty():
		for kind in Kind.values():
			var list: Array = []
			for v in VARIANTS:
				list.append(_make_set(kind, kind * 100 + v))
			_sets[kind] = list


## Random stains in a room. cells: Array of Vector2i
## to_world: Callable(Vector2i) -> Vector3 · wall_dir: Callable(Vector2i) -> Vector2i (ZERO if no wall)
func spawn_in_room(cells: Array, amount: int, to_world: Callable, wall_dir: Callable, cell_size: float) -> void:
	if cells.is_empty():
		return
	for i in amount:
		var cell: Vector2i = cells[_rng.randi_range(0, cells.size() - 1)]
		var center: Vector3 = to_world.call(cell)
		var offset := Vector3(_rng.randf_range(-1.0, 1.0), 0, _rng.randf_range(-1.0, 1.0)) * cell_size * 0.4
		var roll := _rng.randf()
		if roll < 0.30:
			splatter_floor(center + offset, _rng.randf_range(0.9, 2.2), false)
		elif roll < 0.42:
			_floor_decal(Kind.POOL, center + offset, _rng.randf_range(1.2, 2.4))
		elif roll < 0.52:
			_floor_decal(Kind.DRIED, center + offset, _rng.randf_range(1.0, 2.5))
		elif roll < 0.80:
			var dir: Vector2i = wall_dir.call(cell)
			if dir == Vector2i.ZERO:
				splatter_floor(center + offset, 1.2, false)
				continue
			var normal := -Vector3(dir.x, 0, dir.y)
			var along := Vector3(normal.z, 0, -normal.x) * _rng.randf_range(-1.1, 1.1)
			var wall_point := center + Vector3(dir.x, 0, dir.y) * (cell_size / 2.0) + along
			var drip := _rng.randf() < 0.6
			wall_point.y = _rng.randf_range(1.1, 1.9) if drip else _rng.randf_range(0.5, 2.0)
			splatter_wall(wall_point, normal, _rng.randf_range(0.8, 1.6), Kind.DRIP if drip else Kind.SPLATTER)
			# blood that ran down the wall ends in a small pool on the floor
			if drip:
				_floor_decal(Kind.POOL, wall_point - Vector3(dir.x, 0, dir.y) * 0.35, _rng.randf_range(0.5, 0.9))
		else:
			_drag_trail(center + offset, _rng.randf() * TAU, _rng.randf_range(2.5, 5.0))


func splatter_floor(pos: Vector3, size: float, dynamic := true) -> Decal:
	var decal := _floor_decal(Kind.SPLATTER, pos, size)
	if dynamic:
		_track(decal)
	return decal


## normal: direction pointing out of the wall, into the room.
func splatter_wall(pos: Vector3, normal: Vector3, size: float, kind := Kind.SPLATTER) -> Decal:
	var decal := _new_decal(kind, Vector3(size, 0.5, size * (1.6 if kind == Kind.DRIP else 1.0)))
	var y := normal.normalized()
	var z := Vector3.DOWN            # texture "down" (+V) follows gravity
	var x := y.cross(z).normalized()
	decal.basis = Basis(x, y, z)
	if kind != Kind.DRIP:
		decal.basis = decal.basis.rotated(y, _rng.randf() * TAU)
	decal.position = pos + y * 0.15
	add_child(decal)
	return decal


## Big pool that slowly spreads under a dead infected.
func pool(pos: Vector3) -> void:
	var decal := _floor_decal(Kind.POOL, pos, _rng.randf_range(1.6, 2.3))
	_track(decal)
	decal.scale = Vector3(0.15, 1, 0.15)
	var tween := decal.create_tween()
	tween.tween_property(decal, "scale", Vector3.ONE, 4.0).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


## Small splash when a bullet hits an infected.
func hit_splash(pos: Vector3) -> void:
	var p := pos + Vector3(_rng.randf_range(-0.5, 0.5), 0, _rng.randf_range(-0.5, 0.5))
	splatter_floor(p, _rng.randf_range(0.35, 0.7))


## Drag marks: a body was pulled across the floor.
func _drag_trail(start: Vector3, angle: float, length: float) -> void:
	var dir := Vector3(cos(angle), 0, sin(angle))
	var steps := maxi(2, int(length / 1.1))
	for i in steps:
		var p := start + dir * (i * 1.1)
		var decal := _new_decal(Kind.SMEAR, Vector3(1.4, 0.6, 0.7))
		decal.position = Vector3(p.x, 0.05, p.z)
		decal.rotation.y = -angle + _rng.randf_range(-0.12, 0.12)
		decal.modulate.a *= 1.0 - float(i) / steps * 0.5
		add_child(decal)
	_floor_decal(Kind.POOL, start, _rng.randf_range(0.9, 1.4))


func _floor_decal(kind: int, pos: Vector3, size: float) -> Decal:
	var decal := _new_decal(kind, Vector3(size, 0.6, size))
	decal.position = Vector3(pos.x, 0.05, pos.z)
	decal.rotation.y = _rng.randf() * TAU
	add_child(decal)
	return decal


func _new_decal(kind: int, size: Vector3) -> Decal:
	var list: Array = _sets[kind]
	var set: Dictionary = list[_rng.randi_range(0, list.size() - 1)]
	var decal := Decal.new()
	decal.texture_albedo = set["albedo"]
	decal.texture_normal = set["normal"]
	decal.texture_orm = set["orm"]
	decal.size = size
	decal.albedo_mix = 1.0
	decal.normal_fade = 0.3
	decal.modulate = Color(1, 1, 1, _rng.randf_range(0.85, 1.0))
	decal.cull_mask = 1                   # only the lab (layer 1)
	decal.upper_fade = 0.15
	decal.lower_fade = 0.15
	decal.distance_fade_enabled = true
	decal.distance_fade_begin = 35.0
	decal.distance_fade_length = 10.0
	return decal


func _track(decal: Decal) -> void:
	_dynamic.append(decal)
	if _dynamic.size() > MAX_DYNAMIC:
		var old: Decal = _dynamic.pop_front()
		if is_instance_valid(old):
			old.queue_free()


# --- Texture generation -----------------------------------------------------------

## Builds the albedo, normal and ORM textures of one stain.
static func _make_set(kind: int, seed_value: int) -> Dictionary:
	var n := TEXTURE_SIZE
	var rng := RandomNumberGenerator.new()
	rng.seed = 7000 + seed_value
	var noise := FastNoiseLite.new()
	noise.seed = seed_value
	noise.frequency = 0.035
	noise.fractal_octaves = 4
	var fine := FastNoiseLite.new()
	fine.seed = seed_value + 1
	fine.frequency = 0.18

	# 1) Shape: list of [center, radius, stretch] drops + streaks
	var field := PackedFloat32Array()
	field.resize(n * n)
	var c := Vector2(n / 2.0, n / 2.0)
	match kind:
		Kind.POOL:
			_stamp(field, n, c, n * 0.36, Vector2.ONE, noise, 0.35)
			for i in 5:
				_stamp(field, n, c + _rand_vec(rng, n * 0.22), n * rng.randf_range(0.1, 0.18), Vector2.ONE, noise, 0.3)
		Kind.SPLATTER, Kind.DRIED:
			for i in 7:
				_stamp(field, n, c + _rand_vec(rng, n * 0.1), n * rng.randf_range(0.08, 0.17), Vector2.ONE, noise, 0.45)
			for i in rng.randi_range(18, 32):            # flying drops
				var a := rng.randf() * TAU
				var d := rng.randf_range(n * 0.2, n * 0.47)
				_stamp(field, n, c + Vector2(cos(a), sin(a)) * d, rng.randf_range(1.2, 4.5), Vector2.ONE, noise, 0.2)
			for s in rng.randi_range(3, 6):               # radial spatter lines
				var a := rng.randf() * TAU
				for k in 9:
					var p := c + Vector2(cos(a), sin(a)) * (n * 0.16 + k * n * 0.03)
					_stamp(field, n, p, (5.0 - k * 0.45), Vector2(1.0, 1.0), noise, 0.15)
		Kind.DRIP:
			# splash near the top, then streaks running down (+V = down)
			var top := Vector2(n / 2.0, n * 0.22)
			for i in 6:
				_stamp(field, n, top + _rand_vec(rng, n * 0.08), n * rng.randf_range(0.06, 0.12), Vector2.ONE, noise, 0.4)
			for s in rng.randi_range(4, 7):
				var x := top.x + rng.randf_range(-n * 0.16, n * 0.16)
				var width := rng.randf_range(2.0, 4.5)
				var length := rng.randf_range(n * 0.3, n * 0.72)
				var y := top.y
				while y < top.y + length and y < n - 6:
					var t := (y - top.y) / length
					_stamp(field, n, Vector2(x + sin(y * 0.05) * 1.5, y), width * (1.0 - t * 0.5), Vector2.ONE, null, 0.0)
					y += 1.5
				_stamp(field, n, Vector2(x, y), width * 1.3, Vector2.ONE, null, 0.0)   # drop at the end
		Kind.SMEAR:
			# long stroke with bristle lines
			for i in 14:
				var p := Vector2(n * 0.12 + i * n * 0.055, n / 2.0 + rng.randf_range(-4, 4))
				_stamp(field, n, p, n * rng.randf_range(0.12, 0.17), Vector2(1.6, 0.75), noise, 0.35)
			for y in n:
				var stripe := 0.55 + 0.45 * fine.get_noise_2d(0, y * 3.0)
				for x in n:
					field[y * n + x] *= stripe

	# 2) Height (thickness) and colours
	var dried := kind == Kind.DRIED
	var fresh_center := Color(0.30, 0.0, 0.01)
	var fresh_edge := Color(0.48, 0.03, 0.02)
	var dry_center := Color(0.20, 0.06, 0.03)
	var dry_edge := Color(0.33, 0.13, 0.07)
	var height := PackedFloat32Array()
	height.resize(n * n)
	var albedo := Image.create_empty(n, n, false, Image.FORMAT_RGBA8)
	var orm := Image.create_empty(n, n, false, Image.FORMAT_RGB8)
	for y in n:
		for x in n:
			var i := y * n + x
			var v := field[i]
			if v <= 0.0:
				albedo.set_pixel(x, y, Color(0, 0, 0, 0))
				orm.set_pixel(x, y, Color(1, 1, 0))
				continue
			var h := clampf(v * 2.5, 0.0, 1.0)
			height[i] = h
			var grain := fine.get_noise_2d(x, y) * 0.06
			var col: Color = (dry_edge.lerp(dry_center, h) if dried else fresh_edge.lerp(fresh_center, h))
			col = Color(clampf(col.r + grain, 0, 1), clampf(col.g + grain * 0.3, 0, 1), col.b)
			var alpha := clampf(v * 6.0, 0.0, 1.0) * (0.85 if dried else 0.97)
			albedo.set_pixel(x, y, Color(col.r, col.g, col.b, alpha))
			var rough := 0.75 if dried else lerpf(0.45, 0.06, h)   # wet = shiny
			orm.set_pixel(x, y, Color(1.0, rough, 0.0))

	# 3) Normal map from the height
	var normal := Image.create_empty(n, n, false, Image.FORMAT_RGB8)
	var strength := 2.0 if dried else 4.0
	for y in n:
		for x in n:
			var hl := height[y * n + maxi(x - 1, 0)]
			var hr := height[y * n + mini(x + 1, n - 1)]
			var hu := height[maxi(y - 1, 0) * n + x]
			var hd := height[mini(y + 1, n - 1) * n + x]
			var nv := Vector3((hl - hr) * strength, (hu - hd) * strength, 1.0).normalized()
			normal.set_pixel(x, y, Color(nv.x * 0.5 + 0.5, nv.y * 0.5 + 0.5, nv.z * 0.5 + 0.5))

	albedo.generate_mipmaps()
	orm.generate_mipmaps()
	normal.generate_mipmaps()
	return {
		"albedo": ImageTexture.create_from_image(albedo),
		"normal": ImageTexture.create_from_image(normal),
		"orm": ImageTexture.create_from_image(orm),
	}


## Adds a soft drop to the field. The noise makes the outline irregular.
static func _stamp(field: PackedFloat32Array, n: int, center: Vector2, radius: float, stretch: Vector2, noise: FastNoiseLite, roughness: float) -> void:
	if radius <= 0.3:
		return
	var reach := radius * (1.0 + roughness) * maxf(stretch.x, stretch.y) + 1.0
	var x0 := maxi(0, int(center.x - reach))
	var x1 := mini(n - 1, int(center.x + reach))
	var y0 := maxi(0, int(center.y - reach))
	var y1 := mini(n - 1, int(center.y + reach))
	for y in range(y0, y1 + 1):
		for x in range(x0, x1 + 1):
			var d := Vector2((x - center.x) / stretch.x, (y - center.y) / stretch.y).length() / radius
			var v := 1.0 - d
			if noise:
				v += noise.get_noise_2d(x, y) * roughness
			var i := y * n + x
			if v > field[i]:
				field[i] = v


static func _rand_vec(rng: RandomNumberGenerator, spread: float) -> Vector2:
	return Vector2(rng.randf_range(-spread, spread), rng.randf_range(-spread, spread))
